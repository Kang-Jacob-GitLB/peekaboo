{
  "name": "peekaboo",
  "productName": "Peekaboo",
  "version": "0.0.0",
  "description": "Quick file preview for Windows Explorer — press Space to peek.",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "build": "vite build",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "helper:build": "dotnet publish helper/Peekaboo.Helper.csproj -c Release -o helper/publish",
    "helper:console": "dotnet run --project helper/Peekaboo.Helper.csproj -- --console",
    "dist": "npm run helper:build && node scripts/tauri-copy-helper.mjs && npm run build && node scripts/tauri-build.mjs && node scripts/tauri-installer-name.mjs",
    "update-feeds": "node scripts/update-feeds.mjs",
    "next-version": "node scripts/next-version.mjs"
  },
  "//": "렌더러 라이브러리는 vite 가 out/renderer 에 번들하므로 모두 devDependencies 에 둔다. 버전은 릴리스 워크플로가 태그에서 넣으므로 저장소에서는 0.0.0 으로 둔다.",
  "devDependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.0.0",
    "dompurify": "^3.4.17",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "pdfjs-dist": "^6.4.299",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
