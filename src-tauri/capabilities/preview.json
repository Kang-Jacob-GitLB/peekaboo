{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "preview",
  "description": "미리보기 창(label: preview) 전용. core:window 등 창 제어 권한은 주지 않는다.",
  "windows": ["preview"],
  "permissions": [
    "allow-ready",
    "allow-fit",
    "allow-rendered",
    "allow-close",
    "allow-text-selected",
    "allow-list-dir",
    "allow-native-open",
    "allow-native-resize",
    "allow-native-close",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
