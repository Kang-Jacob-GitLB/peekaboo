{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peekaboo",
  "mainBinaryName": "Peekaboo",
  "version": "../package.json",
  "identifier": "io.github.kang-jacob-gitlb.peekaboo",
  "build": {
    "frontendDist": "../out/renderer-tauri"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://peek.localhost; media-src http://peek.localhost; connect-src 'self' ipc: http://ipc.localhost http://peek.localhost; worker-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../resources/tray.png": "tray.png"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
